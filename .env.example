# Supabase — persistencia (auth + datos reales)
# Copia este archivo a .env.local y rellena con los valores de tu proyecto:
#   Supabase → Project Settings → API Keys
#
# La publishable key es PÚBLICA (segura en el cliente). NUNCA pongas aquí la
# secret key (sb_secret_…) ni la contraseña de la base de datos.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
